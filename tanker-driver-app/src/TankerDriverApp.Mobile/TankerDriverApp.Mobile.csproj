<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Один проект собирает Android и iOS (Windows при желании добавить в TargetFrameworks) -->
		<TargetFrameworks>net8.0-android;net8.0-ios</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>TankerDriverApp.Mobile</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<Displayname>Tanker Driver</Displayname>
		<ApplicationTitle>Бензовоз · Водитель</ApplicationTitle>
		<AppId>ru.nefrolines.tankerdriver</AppId>

		<ApplicationVersion>1.0</ApplicationVersion>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- Разрешения для геолокации и фотодоказательств -->
		<AndroidPermission Include="android.permission.ACCESS_FINE_LOCATION" />
		<AndroidPermission Include="android.permission.ACCESS_COARSE_LOCATION" />
		<AndroidPermission Include="android.permission.CAMERA" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="$(MauiVersion)" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\TankerDriverApp.Core\TankerDriverApp.Core.csproj" />
	</ItemGroup>

</Project>
